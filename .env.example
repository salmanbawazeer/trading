# ---- mode -------------------------------------------------------------
# record | backtest | paper | live
MODE=paper
# Required in addition to MODE=live before any real order is sent.
# LIVE_TRADING=I_UNDERSTAND

# ---- Coinbase Advanced Trade (CDP API key, scopes: View + Trade ONLY) ---
COINBASE_API_KEY=organizations/xxxxxxxx/apiKeys/xxxxxxxx
COINBASE_API_SECRET="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n"

# ---- market -----------------------------------------------------------
PRODUCT_ID=USDT-GBP
CAPITAL_GBP=1000

# ---- risk (defaults tuned for < GBP 1,000) -----------------------------
ORDER_NOTIONAL_GBP=25
MAX_INVENTORY_PCT=0.5
MAX_OPEN_ORDERS=2
DAILY_LOSS_CAP_PCT=0.01
STALE_BOOK_SECONDS=5
MAX_SPREAD_TICKS=20

# ---- strategy ----------------------------------------------------------
MIN_EDGE_TICKS=1
VOL_MULTIPLIER=1.0
VOL_WINDOW_SECONDS=30
REQUOTE_MIN_INTERVAL_S=1.0
MAX_REST_SECONDS=30
INVENTORY_SKEW_TICKS=2
FAIR_BLEND_WEIGHT=0.5

# ---- fees --------------------------------------------------------------
# In paper/live the real rates are read from the API. These are used for
# backtest, or for paper without an API key.
PAPER_MAKER_FEE_RATE=0.0
PAPER_TAKER_FEE_RATE=0.00001
# Set to true only for data collection when the fee check fails (paper only).
ALLOW_UNPROFITABLE_FEES=false

# ---- TypeSafe Jev gate (optional) --------------------------------------
JEV_ENABLED=false
# TYPESAFE_API_KEY=ts_...
JEV_THRESHOLD=0.55
JEV_TIMEOUT_S=0.3

# ---- storage / observability ------------------------------------------
DATA_DIR=./data
METRICS_PORT=9108
LOG_LEVEL=INFO
